# NextGen Smart Parking Configuration

# Camera Source: 0 for webcam, RTSP url, or relative path to a video file (e.g. videos/aitd_parking_lot.mp4)
CAMERA_SOURCE=videos/aitd_parking_lot.mp4

# Model weights configurations
YOLO_MODEL=backend/yolov8s.pt
ALPR_MODEL=license_plate_recognition/best.pt

# Slot Configurations JSON
SLOTS_CONFIG=backend/marked_slots/marked_slots.json
GRAPH_CONFIG=backend/marked_slots/parking_slots.json

# Processing Configurations
DETECTION_CONFIDENCE=0.35
PROCESS_WIDTH=1280
OCR_COOLDOWN_FRAMES=45

# Database Configurations
DATABASE_URL=sqlite+aiosqlite:///backend/parking.db

# Path to Tesseract OCR executable (optional, fallback is EasyOCR)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
